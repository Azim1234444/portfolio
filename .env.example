# EmailJS — create a free account at https://www.emailjs.com
# Copy this file to .env and fill in the values. .env is gitignored.
#
# These are inlined into the client bundle at build time and are public by
# design for the browser SDK. Never put the EmailJS Private Key here.

# Email Services > your service
VITE_EMAILJS_SERVICE_ID=

# Email Templates > your template.
# The template must use these variables, which are the form field `name`
# attributes in src/components/sections/Contact.tsx:
#   {{name}}  {{email}}  {{title}}  {{message}}  {{time}}
# A mismatch fails quietly — the email sends with blank fields.
VITE_EMAILJS_TEMPLATE_ID=

# Account > General > Public Key
VITE_EMAILJS_PUBLIC_KEY=
