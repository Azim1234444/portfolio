# Resend — create a free account at https://resend.com (3,000 emails/month free)
# Set these in Vercel Project Settings > Environment Variables (server-side only, never exposed to browser).

# Required: API key from Resend Dashboard > API Keys
RESEND_API_KEY=

# Optional: Verified sender address on your domain (defaults to onboarding@resend.dev)
# Example once azimhalim.my is verified in Resend: Portfolio Contact <contact@azimhalim.my>
RESEND_FROM_EMAIL=

# Optional: Recipient email address (defaults to azimhebat666@gmail.com)
CONTACT_TO_EMAIL=azimhebat666@gmail.com
